# Copy to .env (or .env.local). Never commit real values.
# The Cloudinary cloud is the shared "oceanbim" one; this site has its own folder in it.
# Server-side only (scripts/upload-media.mjs). The key and secret are the only secrets here.
CLOUDINARY_CLOUD_NAME=oceanbim
CLOUDINARY_FOLDER=formworkforconcrete.com
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public settings, inlined into the static build. On Amplify they are app environment variables (see
# infrastructure/locals.tf); locally they can live in .env.local.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=oceanbim
# Contact form: the Lambda function URL and the Cloudflare Turnstile site key. Without both, the form shows the
# email address instead of submitting.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional override. GA4 defaults to the current property.
# NEXT_PUBLIC_GA_ID=G-YR5V883PZR
